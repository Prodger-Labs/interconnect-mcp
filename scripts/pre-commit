#!/usr/bin/env bash
# Pre-commit hook: block commits containing API keys or tokens.
# Install via: bash scripts/install-hooks.sh

PATTERNS=(
  'sk-ant-'           # Anthropic
  'gsk_'              # Groq
  'AIza'              # Google API key
  'ghp_'              # GitHub personal access token
  'gho_'              # GitHub OAuth token
  'github_pat_'       # GitHub fine-grained PAT
  'ops_'              # 1Password service account
  'tk_[a-z0-9]{20}' # ntfy token
)

STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

for pattern in "${PATTERNS[@]}"; do
  match=$(git diff --cached | grep '^\+' | grep -v '^\+\+\+' | grep -E "$pattern" | head -1)
  if [ -n "$match" ]; then
    echo "BLOCKED: commit contains what looks like a secret (pattern: $pattern)"
    echo "  $match"
    echo "Remove the secret and try again."
    exit 1
  fi
done

exit 0
